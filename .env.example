# Neo4j Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=neo4j

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# Optional
ENABLE_GRAPH_RETRIEVAL=true
# Retrieval fusion arm: rrf3 (default), rrf2, wrrf3, cc3, sum_legacy
RETRIEVAL_FUSION_ARM=rrf3
# RS-23 category recovery before the CLARIFY guardrail: 1 (default) on; 0 / false / no reproduce the pre-R2 guardrail
ORCH_CATEGORY_RECOVERY=1

# Graph volume and memory (graph v2, docker-compose.yml). NEO4J_DATA_VOLUME is required: the external
# Docker volume compose mounts as /data (the v1 volume or kg_neo4j_data_v2).
NEO4J_DATA_VOLUME=kg_neo4j_data_v2
# The v1 graph volume; import_graph_v2.py refuses to import into it
NEO4J_DATA_VOLUME_V1=your_v1_volume_name
# Runtime profile defaults; build profile: NEO4J_HEAP=4G NEO4J_PAGECACHE=1G NEO4J_TX_TIMEOUT=600s NEO4J_TX_LOG_RETENTION="500M size"
NEO4J_HEAP=2G
NEO4J_PAGECACHE=2G
NEO4J_TX_TIMEOUT=60s
NEO4J_TX_LOG_RETENTION="2 days"
# Directory for offline graph dumps (outside git)
GRAPH_BACKUP_DIR=~/neo4j-backups
